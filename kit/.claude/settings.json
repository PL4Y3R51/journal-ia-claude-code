{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log_prompt.py"],
            "statusMessage": "Journal IA : prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log_response.py"],
            "statusMessage": "Journal IA : réponse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log_action.py"],
            "statusMessage": "Journal IA : action"
          }
        ]
      }
    ]
  }
}
